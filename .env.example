# Copy this file to .env and fill in your key. .env is git-ignored.

# LLM provider (Groq — free key at https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Weather API timeouts (seconds)
HTTP_TIMEOUT=10

# gpt-oss reasoning effort: low | medium | high (low = ~3x fewer tokens)
GROQ_REASONING_EFFORT=low
